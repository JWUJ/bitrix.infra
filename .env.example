# Project-specific configuration for hiik.ru
# Copy to .env (which is gitignored) and uncomment/adjust what you need.

# ── nginx ports ───────────────────────────────────────────────────────────────
# HTTP_PORT=80
# HTTPS_PORT=443

# ── timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Vladivostok

# ── MySQL database name ───────────────────────────────────────────────────────
MYSQL_DATABASE=hiik_bitrix

# ── Docker network MTU ────────────────────────────────────────────────────────
DOCKER_MTU=1500

# ── Domain (used by certbot and FTP) ─────────────────────────────────────────
MAIN_DOMAIN=hiik.ru
DOMAIN=hiik.ru

# ── Let's Encrypt / DNSroboCert ──────────────────────────────────────────────
CERTBOT_PROVIDER=none
CERTBOT_EMAIL=admin@hiik.ru
ADMIN_EMAIL=admin@hiik.ru

# ── Compose project name ──────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=hiik

# Account (uid 1000) that owns the checkout and runs the deploy pulls and backups; default admin
#DEPLOY_USER=admin
